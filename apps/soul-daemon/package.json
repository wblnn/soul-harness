{
  "name": "@soul-harness/soul-daemon",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Soul Harness daemon: application assembly, lifecycle, single-instance lock and persistence bootstrap. No cognitive logic, no transports yet.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "bin": {
    "soul-daemon": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node src/main.ts",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.7",
    "@soul-harness/contracts": "workspace:*",
    "@soul-harness/persistence": "workspace:*",
    "@soul-harness/runtime": "workspace:*",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
